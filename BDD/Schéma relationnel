-- classe utilisateurs

- id_utilisateur : int (pk)
- email : varchar(150) (uk)
- mot_de_passe_hash : varchar(255)
- role : enum('client','admin')
- actif : boolean
- date_creation : datetime

association :
utilisateurs 1 -------- 0..1 client
(1 utilisateur peut avoir 0 ou 1 fiche client)


-- classe client

- id_client : int (pk)
- id_utilisateur : int (fk, uk)
- nom : varchar(80)
- prenom : varchar(80)
- telephone : varchar(25)
- adresse : varchar(255)
- ville : varchar(100)
- pays : varchar(100)
- date_creation : datetime

associations :
client 1 -------- 0..n reservations_destinations
client 1 -------- 0..n reservations_voyages


-- classe continents

- id_continent : int (pk)
- nom : varchar(50) (uk)

association :
continents 1 -------- 0..n destinations
(1 continent contient plusieurs destinations)


-- classe destinations

- id_destination : int (pk)
- pays : varchar(100)
- ville : varchar(100)
- id_continent : int (fk, nullable)
- description : text
- prix_base : decimal(10,2)
- image_url : varchar(255)
- actif : boolean
- date_creation : datetime

associations :
destinations 1 -------- 0..n voyages_organises
destinations 1 -------- 0..n offres
destinations 1 -------- 0..n reservations_destinations

note :
id_continent peut être null (on delete set null)


-- classe voyages_organises

- id_voyage : int (pk)
- id_destination : int (fk)
- titre : varchar(150)
- description : text
- date_depart : date
- date_retour : date
- prix : decimal(10,2)
- nb_places : int
- nb_places_restantes : int
- image_url : varchar(255)
- statut : enum('actif','complet','annule')
- date_creation : datetime

associations :
voyages_organises 1 -------- 0..n reservations_voyages
destinations 1 -------- 0..n voyages_organises (rappel)


-- classe offres

- id_offre : int (pk)
- id_destination : int (fk)
- titre : varchar(150)
- pourcentage_reduction : int
- date_debut : date
- date_fin : date
- actif : boolean
- date_creation : datetime

association :
destinations 1 -------- 0..n offres


-- classe reservations_destinations

- id_reservation_destination : int (pk)
- id_client : int (fk)
- id_destination : int (fk)
- date_depart : date
- date_retour : date
- nb_personnes : int
- prix_total : decimal(10,2)
- statut : enum('en_attente','confirmee','annulee')
- date_reservation : datetime

associations :
client 1 -------- 0..n reservations_destinations
destinations 1 --- 0..n reservations_destinations


-- classe reservations_voyages

- id_reservation_voyage : int (pk)
- id_client : int (fk)
- id_voyage : int (fk)
- nb_personnes : int
- prix_total : decimal(10,2)
- statut : enum('en_attente','confirmee','annulee')
- date_reservation : datetime

associations :
client 1 -------- 0..n reservations_voyages
voyages_organises 1 ---- 0..n reservations_voyages


-- détails qui font pro (à dire si besoin)

- séparation utilisateurs / client = sécurité + modularité (admin sans profil client)
- contraintes check : date_retour >= date_depart ; nb_places_restantes <= nb_places ; remise <= 100
- clés étrangères garantissent l’intégrité référentielle
- on delete cascade sur client/utilisateurs pour supprimer proprement
- on delete restrict sur réservations → évite de supprimer une destination/voyage déjà réservé
